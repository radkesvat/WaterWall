{
  "name": "mux-parent-pressure-probe",
  "nodes": [
    {"name": "source", "type": "TcpListener", "next": "mux-client", "settings": {"address": "127.0.0.1", "port": 26880}},
    {"name": "mux-client", "type": "MuxClient", "next": "carrier-out", "settings": {
      "mode": "fixed-connections-count", "per-worker-connections-count": 1,
