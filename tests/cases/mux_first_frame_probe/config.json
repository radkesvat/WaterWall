{
  "name": "mux-first-frame-probe",
  "nodes": [
    {
      "name": "application",
      "type": "TcpListener",
      "settings": { "address": "127.0.0.1", "port": 26720, "nodelay": true },
      "next": "vless-client"
    },
    {
      "name": "vless-client",
      "type": "VlessClient",
      "settings": {
        "uuid": "5783a3e7-e373-51cd-8642-c83782b807c5",
        "address": "127.0.0.1",
        "port": 26723,
        "protocol": "tcp"
      },
      "next": "mux-client"
    },
    {
      "name": "mux-client",
      "type": "MuxClient",
      "settings": { "mode": "fixed-connections-count", "per-worker-connections-count": 1 },
      "next": "carrier-out"
    },
    {
      "name": "carrier-out",
      "type": "TcpConnector",
      "settings": { "address": "127.0.0.1", "port": 26721, "nodelay": true, "fastopen": false }
    },
    {
      "name": "carrier-in",
      "type": "TcpListener",
      "settings": { "address": "127.0.0.1", "port": 26722, "nodelay": true },
      "next": "mux-server"
    },
    {
      "name": "mux-server",
      "type": "MuxServer",
      "next": "vless-server"
    },
    {
      "name": "vless-server",
      "type": "VlessServer",
      "settings": { "uuid": "5783a3e7-e373-51cd-8642-c83782b807c5", "connect": true, "udp": false },
      "next": "destination"
    },
    {
      "name": "destination",
      "type": "TcpConnector",
      "settings": {
        "address": "dest_context->address",
        "port": "dest_context->port",
        "nodelay": true,
        "fastopen": false
      }
    }
  ]
}
