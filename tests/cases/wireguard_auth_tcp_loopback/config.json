{
  "name": "wireguard_auth_tcp_loopback",
  "nodes": [
    {
      "name": "tester-client",
      "type": "TesterClient",
      "next": "proxy-connector"
    },
    {
      "name": "proxy-connector",
      "type": "TcpConnector",
      "settings": {
        "address": "127.0.0.1",
        "port": 9000,
        "nodelay": true,
        "fastopen": false
      }
    },
    {
      "name": "proxy-listener",
      "type": "TcpListener",
      "settings": {
        "address": "127.0.0.1",
        "port": 9000,
        "nodelay": true
      },
      "next": "connection-to-packets"
    },
    {
      "name": "connection-to-packets",
      "type": "ConnectionToPackets",
      "settings": {
        "source-ipv4": "10.90.0.1",
        "target-address": "10.90.0.2",
        "port": 9001,
        "mtu": 1500,
        "dns-behaviour": {
          "resolve": true,
          "strategy": "only-ipv4"
        }
      },
      "next": "wg-client"
    },
    {
      "name": "target-connector",
      "type": "TcpUdpConnector",
      "settings": {
        "address": "127.0.0.1",
        "port": "dest_context->port",
        "nodelay": true,
        "fastopen": false
      }
    },
    {
      "name": "target-listener",
      "type": "TcpListener",
      "settings": {
        "address": "127.0.0.1",
        "port": 9001,
        "nodelay": true
      },
      "next": "tester-server"
    },
    {
      "name": "tester-server",
      "type": "TesterServer"
    },
    {
      "name": "auth-client",
      "type": "AuthenticationClient",
      "settings": {
        "name": "edge-1",
        "secret": "vless-auth-secret",
        "ping-interval-ms": 0,
        "pull-interval-ms": 0,
        "push-interval-ms": 0,
        "reconnect-interval-ms": 1000,
        "request-timeout-ms": 5000,
        "max-pending-requests": 16
      },
      "next": "auth-db"
    },
    {
      "name": "auth-db",
      "type": "AuthenticationServer",
      "settings": {
        "db-path": "users.json",
        "file-save-rate-ms": 60000,
        "session-idle-timeout-ms": 600000,
        "auth-clients": [
          {
            "name": "edge-1",
            "secret": "vless-auth-secret",
            "allow-user-pull": true,
            "allow-stats-push": true,
            "allow-user-write": false
          }
        ]
      }
    },
    {
      "name": "wg-client",
      "type": "WireGuardClient",
      "next": "wg-udp",
      "settings": {
        "privatekey": "OifMN24K7a2acdnkULTG5pAypdiSdqmTAHlbjlRi+tk=",
        "peers": [
          {
            "publickey": "GnRcOavdc180YrXak138cZxWlMoEUZL0Mg/ZyWhLBgo=",
            "allowedips": "0.0.0.0/0",
            "endpoint": "127.0.0.1:27980",
            "persistentkeepalive": 1
          }
        ]
      }
    },
    {
      "name": "wg-udp",
      "type": "UdpConnector",
      "settings": {
        "address": "dest_context->address",
        "port": "dest_context->port"
      }
    },
    {
      "name": "wg-listener",
      "type": "UdpListener",
      "settings": {
        "address": "127.0.0.1",
        "port": 27980
      },
      "next": "wg-server"
    },
    {
      "name": "wg-server",
      "type": "WireGuardServer",
      "settings": {
        "mode": "connection",
        "privatekey": "EBJOHctLU2w8uteyTE+WU0hruB09Ub0vwVS+Gt9wAls=",
        "auth-client-node-name": "auth-client"
      },
      "next": "identity-router"
    },
    {
      "name": "identity-router",
      "type": "Router",
      "settings": {
        "rules": [
          {
            "username": "wireguard-user",
            "password": "wireguard-user-secret",
            "target": "target-connector"
          }
        ]
      },
      "next": "reject"
    },
    {
      "name": "reject",
      "type": "BlackHole",
      "settings": {
        "mode": "passive"
      }
    }
  ]
}
