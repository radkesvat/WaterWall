{
  "name": "ping-direct-real-adapters-roundtrip",
  "nodes": [
    {
      "name": "raw-in-out",
      "type": "RawSocket",
      "settings": {
        "fragment-policy": "reassemble",
        "capture-device-name": "ping-direct-capture",
        "raw-device-name": "ping-direct-raw",
        "capture-filter-mode": "source-ip",
        "capture-ips": [
          "127.0.0.2"
        ],
        "capture-protocols": [
          1
        ],
        "opaque-flow-mode": "peer"
      },
      "next": "carrier-addresses"
    },
    {
      "name": "carrier-addresses",
      "type": "IpOverrider",
      "settings": {
        "up": {
          "source-ip": {
            "ipv4": "10.252.30.2"
          },
          "dest-ip": {
            "ipv4": "10.252.30.1"
          }
        },
        "down": {
          "source-ip": {
            "ipv4": "127.0.0.1"
          },
          "dest-ip": {
            "ipv4": "127.0.0.2"
          }
        }
      },
      "next": "ping-server"
    },
    {
      "name": "ping-server",
      "type": "PingServer",
      "settings": {
        "icmp-type": "experiment-2",
        "icmp-code": 66
      },
      "next": "server-tun"
    },
    {
      "name": "server-tun",
      "type": "TunDevice",
      "settings": {
        "fragment-policy": "reassemble",
        "device-name": "wwpingdirect0",
        "device-ip": "10.252.30.1/24",
        "device-mtu": 1490,
        "route-table": "off"
      }
    }
  ]
}
