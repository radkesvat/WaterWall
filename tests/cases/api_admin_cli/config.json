{
  "name": "admin-fixture",
  "nodes": [
    {
      "name": "accounts",
      "type": "AuthenticationServer",
      "settings": {
        "db-path": "users.json",
        "file-save-rate-ms": 60000,
        "auth-clients": [{"name": "fixture-producer", "secret": "CLIUnusedProducerPassword"}]
      }
    },
    {
      "name": "listener",
      "type": "TcpListener",
      "settings": {"address": "127.0.0.1", "port": 29380},
      "next": "api"
    },
    {
      "name": "api",
      "type": "APIServer",
      "settings": {
        "clients": [
          {
            "name": "admin",
            "token": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "allow": [{"config": "admin-fixture", "node": "accounts", "operations": ["status", "get-user", "list-users", "create-user", "update-user", "change-user-password"]}]
          },
          {
            "name": "monitor",
            "token": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
            "allow": [{"config": "admin-fixture", "node": "accounts", "operations": ["status"]}]
          }
        ]
      }
    }
  ]
}
