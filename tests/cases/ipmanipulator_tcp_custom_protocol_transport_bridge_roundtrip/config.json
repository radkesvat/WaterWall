{
  "name": "ipmanipulator-tcp-custom-protocol-transport-bridge-roundtrip",
  "nodes": [
    {
      "name": "tester-client",
      "type": "TesterClient",
      "settings": {
        "packet-mode": true,
        "chunk-count": 6,
        "packet-ipv4": {
          "source-ip": "10.86.0.1",
          "dest-ip": "10.86.0.2",
          "transport": "tcp",
          "ttl": 64
        }
      },
      "next": "tcp-to-custom"
    },
    {
      "name": "tcp-to-custom",
      "type": "IpManipulator",
      "settings": {
        "protoswap-tcp": 143
      },
      "next": "client-bridge"
    },
    {
      "name": "client-bridge",
      "type": "Bridge",
      "settings": {
        "pair": "server-bridge"
      }
    },
    {
      "name": "tester-server",
      "type": "TesterServer",
      "settings": {
        "packet-mode": true,
        "packet-init-on-start": true,
        "chunk-count": 6,
        "packet-ipv4": {
          "source-ip": "10.86.0.1",
          "dest-ip": "10.86.0.2",
          "transport": "tcp",
          "ttl": 64
        }
      },
      "next": "custom-to-tcp"
    },
    {
      "name": "custom-to-tcp",
      "type": "IpManipulator",
      "settings": {
        "protoswap-tcp": 143
      },
      "next": "server-bridge"
    },
    {
      "name": "server-bridge",
      "type": "Bridge",
      "settings": {
        "pair": "client-bridge"
      }
    }
  ]
}
