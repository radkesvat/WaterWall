{
  "name": "ipmanipulator-udp-custom-protocol-roundtrip",
  "nodes": [
    {
      "name": "tester-client",
      "type": "TesterClient",
      "settings": {
        "packet-mode": true,
        "chunk-count": 6,
        "packet-ipv4": {
          "source-ip": "10.84.0.1",
          "dest-ip": "10.84.0.2",
          "transport": "udp",
          "ttl": 64
        }
      },
      "next": "udp-to-custom"
    },
    {
      "name": "udp-to-custom",
      "type": "IpManipulator",
      "settings": {
        "protoswap-udp": 144
      },
      "next": "custom-to-udp"
    },
    {
      "name": "custom-to-udp",
      "type": "IpManipulator",
      "settings": {
        "protoswap-udp": 144
      },
      "next": "tester-server"
    },
    {
      "name": "tester-server",
      "type": "TesterServer",
      "settings": {
        "packet-mode": true,
        "chunk-count": 6,
        "packet-ipv4": {
          "source-ip": "10.84.0.1",
          "dest-ip": "10.84.0.2",
          "transport": "udp",
          "ttl": 64
        }
      }
    }
  ]
}
