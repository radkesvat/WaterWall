{
  "name": "tcpudp-udp-over-tcp-udp-roundtrip",
  "nodes": [
    {
      "name": "tester-client",
      "type": "TesterClient",
      "settings": {
        "max-payload-size": 3800,
        "chunk-count": 9,
        "split-payload-delay-ms": 5,
        "split-payload-burst": 1
      },
      "next": "outer-udp-connector"
    },
    {
      "name": "outer-udp-connector",
      "type": "UdpConnector",
      "settings": {
        "address": "127.0.0.1",
        "port": 24950
      }
    },
    {
      "name": "tcpudp-listener",
      "type": "TcpUdpListener",
      "settings": {
        "address": "127.0.0.1",
        "port": 24950
      },
      "next": "select-transport"
    },
    {
      "name": "select-transport",
      "type": "Router",
      "settings": {
        "rules": [{"network": "udp", "target": "uot-client"}]
      },
      "next": "discard-stream"
    },
    {
      "name": "discard-stream",
      "type": "BlackHole",
      "settings": {"mode": "passive"}
    },
    {
      "name": "uot-client",
      "type": "UdpOverTcpClient",
      "next": "write-line-mark"
    },
    {
      "name": "write-line-mark",
      "type": "HeaderClient",
      "settings": {"data": "line-mark", "mark": "0102030405060708090a0b0c0d0e0f10"},
      "next": "carrier-tcp-connector"
    },
    {
      "name": "carrier-tcp-connector",
      "type": "TcpConnector",
      "settings": {
        "address": "127.0.0.1",
        "port": 24951,
        "nodelay": true,
        "fastopen": false
      }
    },
    {
      "name": "carrier-tcp-listener",
      "type": "TcpListener",
      "settings": {
        "address": "127.0.0.1",
        "port": 24951,
        "nodelay": true
      },
      "next": "read-line-mark"
    },
    {
      "name": "read-line-mark",
      "type": "HeaderServer",
      "settings": {"override": "line-mark"},
      "next": "route-marked-stream"
    },
    {
      "name": "route-marked-stream",
      "type": "Router",
      "settings": {"rules": [{"network": "tcp", "line-mark": "0102030405060708090a0b0c0d0e0f10", "target": "uot-server"}]},
      "next": "discard-unmarked-stream"
    },
    {
      "name": "discard-unmarked-stream",
      "type": "BlackHole",
      "settings": {"mode": "passive"}
    },
    {
      "name": "uot-server",
      "type": "UdpOverTcpServer",
      "next": "tcpudp-connector"
    },
    {
      "name": "tcpudp-connector",
      "type": "TcpUdpConnector",
      "settings": {
        "address": "127.0.0.1",
        "port": 24952
      }
    },
    {
      "name": "outer-udp-listener",
      "type": "UdpListener",
      "settings": {
        "address": "127.0.0.1",
        "port": 24952
      },
      "next": "tester-server"
    },
    {
      "name": "tester-server",
      "type": "TesterServer",
      "settings": {
        "max-payload-size": 3800,
        "chunk-count": 9,
        "split-payload-burst": 1
      }
    }
  ]
}
