{
  "name": "api-server",
  "nodes": [
    {
      "name": "auth-db",
      "type": "AuthenticationServer",
      "settings": {
        "db-path": "users.json",
        "file-save-rate-ms": 60000,
        "auth-clients": [
          {
            "name": "fixture-writer",
            "secret": "NeverExposeProducerSecret",
            "allow-user-write": true,
            "allow-stats-push": true,
            "allow-user-pull": true
          }
        ]
      }
    },
    {
      "name": "api-listener",
      "type": "TcpListener",
      "settings": {
        "address": "127.0.0.1",
        "port": 29380
      },
      "next": "management-api"
    },
    {
      "name": "management-api",
      "type": "APIServer",
      "settings": {
        "clients": [
          {
            "name": "auditor",
            "token": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "allow": [
              {
                "config": "api-server",
                "node": "auth-db",
                "operations": [
                  "status",
                  "get-user",
                  "list-users"
                ]
              }
            ]
          },
          {
            "name": "monitor",
            "token": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
            "allow": [
              {
                "config": "api-server",
                "node": "auth-db",
                "operations": [
                  "status"
                ]
              }
            ]
          },
          {
            "name": "editor",
            "token": "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210",
            "allow": [
              {
                "config": "api-server",
                "node": "auth-db",
                "operations": [
                  "get-user",
                  "update-user"
                ]
              }
            ]
          },
          {
            "name": "creator",
            "token": "13579bdf02468ace13579bdf02468ace13579bdf02468ace13579bdf02468ace",
            "allow": [
              {
                "config": "api-server",
                "node": "auth-db",
                "operations": [
                  "get-user",
                  "create-user"
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "name": "protocol-listener",
      "type": "TcpListener",
      "settings": {
        "address": "127.0.0.1",
        "port": 29382
      },
      "next": "auth-db"
    },
    {
      "name": "small-response-listener",
      "type": "TcpListener",
      "settings": {
        "address": "127.0.0.1",
        "port": 29381
      },
      "next": "small-response-api"
    },
    {
      "name": "small-response-api",
      "type": "APIServer",
      "settings": {
        "clients": [
          {
            "name": "auditor",
            "token": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "allow": [
              {
                "config": "api-server",
                "node": "auth-db",
                "operations": [
                  "status",
                  "get-user",
                  "list-users"
                ]
              }
            ]
          },
          {
            "name": "monitor",
            "token": "abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789",
            "allow": [
              {
                "config": "api-server",
                "node": "auth-db",
                "operations": [
                  "status"
                ]
              }
            ]
          },
          {
            "name": "editor",
            "token": "fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210",
            "allow": [
              {
                "config": "api-server",
                "node": "auth-db",
                "operations": [
                  "get-user",
                  "update-user"
                ]
              }
            ]
          },
          {
            "name": "creator",
            "token": "13579bdf02468ace13579bdf02468ace13579bdf02468ace13579bdf02468ace",
            "allow": [
              {
                "config": "api-server",
                "node": "auth-db",
                "operations": [
                  "get-user",
                  "create-user"
                ]
              }
            ]
          }
        ],
        "max_response_envelope": 1024
      }
    }
  ]
}
