{
  "name": "device_fragment_preserve_stack_roundtrip",
  "nodes": [
    {
      "name": "tun",
      "type": "TunDevice",
      "next": "stack",
      "settings": {
        "fragment-policy": "preserve-fragments",
        "device-name": "wwfrag0",
        "device-ip": "10.253.80.1/24",
        "device-mtu": 1500,
        "route-table": "off"
      }
    },
    {
      "name": "stack",
      "type": "PacketsToConnection",
      "next": "select-transport"
    },
    {
      "name": "select-transport",
      "type": "Router",
      "settings": {
        "rules": [{"network": "udp", "target": "out"}]
      },
      "next": "discard-other-transport"
    },
    {
      "name": "discard-other-transport",
      "type": "BlackHole",
      "settings": {"mode": "passive"}
    },
    {
      "name": "out",
      "type": "UdpConnector",
      "settings": {
        "address": "127.0.0.1",
        "port": 24371
      }
    }
  ]
}
