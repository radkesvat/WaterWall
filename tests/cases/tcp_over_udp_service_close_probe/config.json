{
  "name": "tcp-over-udp-service-close-probe",
  "nodes": [
    {
      "name": "udp-path-listener",
      "type": "TcpListener",
      "settings": { "address": "127.0.0.1", "port": 26690, "nodelay": true },
      "next": "udp-path-client"
    },
    {
      "name": "udp-path-client",
      "type": "TcpOverUdpClient",
      "settings": { "kcp-recv-window": 128 },
      "next": "udp-out"
    },
    {
      "name": "udp-out",
      "type": "UdpConnector",
      "settings": { "address": "127.0.0.1", "port": 26691 }
    },
    {
      "name": "udp-in",
      "type": "UdpListener",
      "settings": { "address": "127.0.0.1", "port": 26691 },
      "next": "udp-path-server"
    },
    {
      "name": "udp-path-server",
      "type": "TcpOverUdpServer",
      "next": "udp-path-service"
    },
    {
      "name": "udp-path-service",
      "type": "TcpConnector",
      "settings": { "address": "127.0.0.1", "port": 26693, "fastopen": false }
    },
    {
      "name": "direct-listener",
      "type": "TcpListener",
      "settings": { "address": "127.0.0.1", "port": 26692, "nodelay": true },
      "next": "direct-client"
    },
    {
      "name": "direct-client",
      "type": "TcpOverUdpClient",
      "settings": { "kcp-recv-window": 128 },
      "next": "direct-server"
    },
    {
      "name": "direct-server",
      "type": "TcpOverUdpServer",
      "next": "direct-service"
    },
    {
      "name": "direct-service",
      "type": "TcpConnector",
      "settings": { "address": "127.0.0.1", "port": 26693, "fastopen": false }
    }
  ]
}
