if(DEFINED PATCH_CASE)
  include("${PATCH_SOURCE_DIR}/ww/lwip/pretend_patch.cmake")
  if(PATCH_CASE STREQUAL "repeated")
    ww_lwip_replace_all("${PATCH_INPUT}" "before" "after" 2)
  elseif(PATCH_CASE STREQUAL "wrong_repeated_count")
    ww_lwip_replace_all("${PATCH_INPUT}" "before" "after" 3)
  else()
    ww_lwip_replace_once("${PATCH_INPUT}" "before" "after")
  endif()
  return()
endif()

file(MAKE_DIRECTORY "${PATCH_TEST_DIR}")
foreach(case IN ITEMS unique missing duplicate repeated wrong_repeated_count)
  if(case STREQUAL "unique")
    set(original "before keep")
    set(expected "after keep")
    set(succeeds TRUE)
  elseif(case STREQUAL "missing")
    set(original "unchanged")
    set(expected "${original}")
    set(succeeds FALSE)
    set(diagnostic "expected 1 occurrences, found 0")
  elseif(case STREQUAL "duplicate")
    set(original "before keep before")
    set(expected "${original}")
    set(succeeds FALSE)
    set(diagnostic "expected 1 occurrences, found 2")
  elseif(case STREQUAL "repeated")
    set(original "before keep before")
    set(expected "after keep after")
    set(succeeds TRUE)
  else()
    set(original "before keep before")
    set(expected "${original}")
    set(succeeds FALSE)
    set(diagnostic "expected 3 occurrences, found 2")
  endif()

  set(input "${PATCH_TEST_DIR}/${case}.txt")
  file(WRITE "${input}" "${original}")
  execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DPATCH_SOURCE_DIR=${PATCH_SOURCE_DIR}" "-DPATCH_CASE=${case}" "-DPATCH_INPUT=${input}"
    -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(READ "${input}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${case}: replacement changed unexpected bytes: ${actual}")
  endif()
  if(succeeds)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "${case}: expected success: ${output}${error}")
    endif()
  else()
    string(REGEX REPLACE "[ \r\n\t]+" " " normalized_error "${error}")
    string(FIND "${normalized_error}" "${input}" file_found)
    string(FIND "${normalized_error}" "${diagnostic}" count_found)
    if(result EQUAL 0 OR file_found LESS 0 OR count_found LESS 0)
      message(FATAL_ERROR "${case}: expected file/count diagnostic: ${output}${error}")
    endif()
  endif()
endforeach()
message(STATUS "Checked literal replacements preserve unique/repeated edits and reject unchanged files with count diagnostics")
