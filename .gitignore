.pytest_cache/

# Generated test runner artifacts.
# The case runners now build these inside a private run directory under TMPDIR,
# so a normal `ctest` run leaves the source tree untouched. These entries still
# cover older in-place leftovers and runners that write beside their inputs;
# `tests/cleanup_generated_outputs.sh` removes them.
/tests/cases/*/core.json
/tests/cases/*/stdout.log
/tests/cases/*/log/
/tests/cases/*/packet-receiver-report.txt
/tests/cases/*/users.json.backup
/tests/cases/tls_handshake_timeout_slow_drip/server.crt
/tests/cases/tls_handshake_timeout_slow_drip/server.key
/tests/cases/tls_tlslike_invalid_probe_does_not_fallback/server.crt
/tests/cases/tls_tlslike_invalid_probe_does_not_fallback/server.key
/tests/cases/tls_tlslike_oversized_probe_does_not_fallback/server.crt
/tests/cases/tls_tlslike_oversized_probe_does_not_fallback/server.key
/tests/speedtests/*/core.json
/tests/speedtests/*/stdout.log
/tests/speedtests/*/log/
/tests/speedtests/*/server.crt
/tests/speedtests/*/server.key
!/tests/speedtests/_shared/server.crt
!/tests/speedtests/_shared/server.key
/tests/unittests/log/
