        },
        {
            "name": "linux-software-crypto-tls-unit",
            "inherits": ["linux-software-crypto-tls", "native-unit-tests"]
        },
        {
            "name": "linux-software-crypto-sanitize-unit",
            "inherits": ["linux-software-crypto-sanitize", "native-unit-tests"]
        },
        {
            "name": "linux-software-crypto",
            "inherits": [
                "host-linux",
                "target-linux",
                "ninja",
                "ccache",
                "default"
            ],
            "cacheVariables": {
                "WCRYPTO_BACKEND_OPENSSL": false,
                "WCRYPTO_BACKEND_SODIUM": false,
                "INCLUDE_TLS_SERVER": false,
                "router_enable_quic_sniffing": false
            }
        },
        {
            "name": "linux-sodium-crypto",
            "inherits": [
                "host-linux",
                "target-linux",
                "ninja",
                "ccache",
                "default"
            ],
            "cacheVariables": {
                "WCRYPTO_BACKEND_OPENSSL": false,
                "WCRYPTO_BACKEND_SODIUM": true,
                "INCLUDE_TLS_SERVER": false,
                "router_enable_quic_sniffing": false
            }
        },
        {
            "name": "linux-openssl-crypto",
            "inherits": [
                "host-linux",
                "target-linux",
                "ninja",
                "ccache",
                "default"
            ],
            "cacheVariables": {
                "WCRYPTO_BACKEND_OPENSSL": true,
                "WCRYPTO_BACKEND_SODIUM": false,
                "INCLUDE_TLS_SERVER": false,
                "router_enable_quic_sniffing": false
            }
        },
        {
            "name": "linux-combined-crypto",
            "inherits": [
                "host-linux",
                "target-linux",
                "ninja",
                "ccache",
                "default"
