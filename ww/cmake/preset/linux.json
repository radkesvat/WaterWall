{
    "version": 4,
    "include": [
        "base.json"
    ],
    "configurePresets": [
        {
            "name": "linux",
            "inherits": [
                "host-linux",
                "target-linux",
                "ninja",
                "ccache",
                "default"
            ]
        },
        {
            "name": "linux-unit-tests",
            "inherits": [
                "host-linux",
                "target-linux",
                "ninja",
                "ccache",
                "native-unit-tests",
                "default"
            ],
            "cacheVariables": {}
        },
        {
            "name": "linux-tsan-unit",
            "inherits": "linux-unit-tests",
            "cacheVariables": {
                "ENABLE_TSAN": true
            }
        },
        {
            "name": "linux-software-crypto-unit",
            "inherits": ["linux-software-crypto", "native-unit-tests"]
        },
        {
            "name": "linux-sodium-crypto-unit",
            "inherits": ["linux-sodium-crypto", "native-unit-tests"]
        },
        {
            "name": "linux-openssl-crypto-unit",
            "inherits": ["linux-openssl-crypto", "native-unit-tests"]
        },
