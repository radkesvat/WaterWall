        {
            "name": "linux-software-crypto-sanitize",
            "inherits": "linux-software-crypto",
            "cacheVariables": {
                "ENABLE_ASAN": true,
                "ENABLE_USAN": true,
                "INCLUDE_TLS_SERVER": true
            }
        },
        {
            "name": "linux-software-crypto-tls",
            "inherits": "linux-software-crypto",
            "cacheVariables": {
                "INCLUDE_TLS_SERVER": true
            }
        },
