{
  "name": "http-proxy-connect",
  "nodes": [
    {"name": "listen", "type": "TcpListener", "next": "proxy", "settings": {"address": "127.0.0.1", "port": 8443}},
    {"name": "proxy", "type": "HttpProxyClient", "next": "transport", "settings": {"target-address": "origin.example", "port": 443}},
    {"name": "transport", "type": "TcpConnector", "settings": {"address": "127.0.0.1", "port": 8080}}
  ]
}
