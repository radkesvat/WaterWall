{
  "name": "gns-obfuscated-client",
  "nodes": [
    {
      "name": "application",
      "type": "TcpListener",
      "next": "gns-client",
      "settings": {
        "address": "127.0.0.1",
        "port": 1080,
        "nodelay": true
      }
    },
    {
      "name": "gns-client",
      "type": "GnsClient",
      "next": "obfuscator-client",
      "settings": {
        "send-mtu": 1400,
        "send-rate": 4194304
      }
    },
    {
      "name": "obfuscator-client",
      "type": "ObfuscatorClient",
      "next": "transport",
      "settings": {
        "method": "xor",
        "xor_key": 90,
        "skip": "none",
        "tls_record_header": false
      }
    },
    {
      "name": "transport",
      "type": "UdpConnector",
      "settings": {
        "address": "127.0.0.1",
        "port": 8443
      }
    }
  ]
}
