+int SSL_set1_ech_grease_override_name(SSL *ssl, const uint8_t *name,
+                                      size_t name_len) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    return 0;
+  }
+
+  if (name == nullptr || name_len == 0) {
+    ssl_impl->config->ech_grease_override_name.Reset();
+    return 1;
+  }
+
+  return ssl_impl->config->ech_grease_override_name.CopyFrom(
+      Span(name, name_len));
+}
